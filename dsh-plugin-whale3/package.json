{
  "name": "@purezhi/dsh-plugin-whale3",
  "version": "1.0.0",
  "description": "An animated whale companion for the DSH UI. Default humpback, right-click cycles blue whale / orca; drag to reposition. Lives in the user profile so it survives app upgrades.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/purezhi/dsh-plugin-whale3"
  },
  "author": "purezhi",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "whale",
    "companion"
  ],
  "homepage": "https://github.com/purezhi/dsh-plugin-whale3#readme",
  "bugs": {
    "url": "https://github.com/purezhi/dsh-plugin-whale3/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "node build.js",
    "prepare": "node build.js"
  },
  "files": [
    "lib",
    "build.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": true
}
