{
  "name": "dsh-plugin-whale",
  "version": "1.0.0",
  "description": "An animated whale companion for the DSH UI. Default humpback, right-click cycles blue whale / orca; drag to reposition. Lives in the user profile so it survives app upgrades.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/purezhi/dsh-plugin-whale.git"
  },
  "author": "purezhi",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "whale",
    "companion"
  ]
}
